# Waygood Candidate Evaluation - Root Environment Template
# Copy this file or backend/.env.example to backend/.env

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/waygood-evaluation?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=5d

# Performance & Caching
CACHE_TTL_SECONDS=300
# Optional Redis URL. If left empty, system automatically uses in-memory cache.
REDIS_URL=

# Automatic Database Seeding
AUTO_SEED=true

# AI Service Configuration (Groq API)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Frontend Configuration (see frontend/.env.example)
VITE_API_URL=/api
