{
  "info": {
    "_postman_id": "waygood-study-abroad-evaluation-api-v1",
    "name": "Waygood Study Abroad Platform API",
    "description": "Complete Postman collection for the Waygood Candidate Evaluation study-abroad backend, covering Authentication, Discovery, 5-Factor Recommendations, Application State Machine, Groq AI Planning, and Counselor Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "counselorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId",
      "value": "",
      "type": "string"
    },
    {
      "key": "universityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check backend uptime and MongoDB connection state."
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Profile",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohit Sharma\",\n  \"email\": \"rohit.student@example.com\",\n  \"password\": \"Password123!\",\n  \"preferredCountries\": [\n    \"Canada\",\n    \"United Kingdom\"\n  ],\n  \"budget\": 35000,\n  \"fieldOfStudy\": [\n    \"Computer Science\",\n    \"Software Engineering\"\n  ],\n  \"intake\": \"Fall 2025\",\n  \"ieltsScore\": 7.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Student (Demo: Aarav Patel)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "  pm.collectionVariables.set('studentToken', jsonData.data.token);",
                  "  if (jsonData.data.user && jsonData.data.user.id) {",
                  "    pm.collectionVariables.set('studentId', jsonData.data.user.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav@example.com\",\n  \"password\": \"Candidate123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Counselor (Demo: Priya Sharma)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "  pm.collectionVariables.set('counselorToken', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"counselor.priya@example.com\",\n  \"password\": \"Candidate123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update Profile Preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Patel\",\n  \"budget\": 42000,\n  \"preferredCountries\": [\n    \"Canada\",\n    \"United Kingdom\",\n    \"United States\"\n  ],\n  \"fieldOfStudy\": [\n    \"Computer Science\",\n    \"Artificial Intelligence\"\n  ],\n  \"intake\": \"Fall 2025\",\n  \"ieltsScore\": 7.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Upload Document to Vault",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"transcripts\",\n  \"title\": \"Official Undergraduate Transcript\",\n  \"fileName\": \"undergrad_transcript.pdf\",\n  \"fileSize\": 1048576,\n  \"notes\": \"Attested by college registrar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "documents"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. University Discovery",
      "item": [
        {
          "name": "List Universities (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities?country=Canada&page=1&limit=5&sortBy=qsRanking&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "universities"
              ],
              "query": [
                {
                  "key": "country",
                  "value": "Canada"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sortBy",
                  "value": "qsRanking"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Popular Universities Carousel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities/popular?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "universities",
                "popular"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get University Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities/{{universityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "universities",
                "{{universityId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Program Discovery",
      "item": [
        {
          "name": "Search Programs with Multi-Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs?country=Canada&field=Computer Science&maxTuition=45000&ieltsScore=7.0&intake=Fall 2025&page=1&limit=10&sortBy=tuitionFeeUsd&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programs"
              ],
              "query": [
                {
                  "key": "country",
                  "value": "Canada"
                },
                {
                  "key": "field",
                  "value": "Computer Science"
                },
                {
                  "key": "maxTuition",
                  "value": "45000"
                },
                {
                  "key": "ieltsScore",
                  "value": "7.0"
                },
                {
                  "key": "intake",
                  "value": "Fall 2025"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "tuitionFeeUsd"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Program Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programs",
                "{{programId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Recommendation Engine",
      "item": [
        {
          "name": "Get Recommendations for Logged-In Student",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get Recommendations by Student ID (Counselor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{counselorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/{{studentId}}?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations",
                "{{studentId}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Application Lifecycle & Workflow",
      "item": [
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"{{programId}}\",\n  \"intake\": \"Fall 2025\",\n  \"notes\": \"Applying for early consideration with IELTS 7.5\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            }
          }
        },
        {
          "name": "List Applications (Role Scoped)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            }
          }
        },
        {
          "name": "Advance Status (Counselor: under-review -> offer-received)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{counselorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"under-review\",\n  \"note\": \"Transcripts verified and forwarded to university admissions committee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Withdraw Application (Student)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Student accepted alternative offer elsewhere\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/withdraw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{applicationId}}",
                "withdraw"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. AI Strategic Planning & Insights (Groq)",
      "item": [
        {
          "name": "POST /api/ai/study-plan (Full Strategic Roadmap)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/study-plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "study-plan"
              ]
            },
            "description": "Generates structured JSON study plan with shortlist, backwards timeline, documents checklist, budget notes, and next steps."
          }
        },
        {
          "name": "POST /api/ai/recommendation-insights (Fit & Watch-outs)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/recommendation-insights",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "recommendation-insights"
              ]
            },
            "description": "Generates grounded program-by-program explanations ('whyItFits', 'watchOut') and counselor advice."
          }
        }
      ]
    },
    {
      "name": "8. Counselor Dashboard",
      "item": [
        {
          "name": "Get Application Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{counselorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "stats"
              ]
            }
          }
        }
      ]
    }
  ]
}