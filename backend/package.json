{
  "name": "waygood-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend starter for the Waygood candidate evaluation project.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:phase1": "node src/scripts/testPhase1.js",
    "test:phase2": "node src/scripts/testPhase2.js",
    "test:phase3": "node src/scripts/testPhase3.js",
    "test:phase4": "node src/scripts/testPhase4.js",
    "test:phase5": "node src/scripts/testPhase5.js",
    "test:phase7": "node src/scripts/testPhase7.js",
    "test:phase10": "node src/scripts/testPhase10.js",
    "verify:explain": "node src/scripts/verifyExplain.js",
    "test:all": "node src/scripts/testPhase1.js && node src/scripts/testPhase2.js && node src/scripts/testPhase3.js && node src/scripts/testPhase4.js && node src/scripts/testPhase5.js && node src/scripts/testPhase7.js && node src/scripts/testPhase10.js && node src/scripts/verifyExplain.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 45000,
    "verbose": true
  }
}
