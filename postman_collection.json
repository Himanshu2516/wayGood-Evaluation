              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"phone\": \"+1-416-555-0199\",\n  \"currentEducation\": \"Bachelor of Technology in CS\",\n  \"gpa\": \"3.85 / 4.0\",\n  \"budget\": 35000,\n  \"ieltsScore\": 7.5,\n  \"intake\": \"Fall 2025\",\n  \"preferredCountries\": [\"Canada\", \"United Kingdom\", \"United States\"],\n  \"fieldOfStudy\": [\"Computer Science\", \"Data Science\", \"Machine Learning\"]\n}"
