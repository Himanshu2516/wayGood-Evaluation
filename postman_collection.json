          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs?page=1&limit=10&sort=tuitionFeeUsd",
              "host": ["{{baseUrl}}"],
              "path": ["programs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "tuitionFeeUsd" }
              ]
            }
          }
        },
        {
          "name": "Filter Programs (Country, Field, Budget, IELTS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs?country=Canada&field=Computer Science&maxTuitionUsd=35000&ieltsScore=7.5&intake=Fall 2025",
              "host": ["{{baseUrl}}"],
              "path": ["programs"],
              "query": [
                { "key": "country", "value": "Canada" },
                { "key": "field", "value": "Computer Science" },
                { "key": "maxTuitionUsd", "value": "35000" },
                { "key": "ieltsScore", "value": "7.5" },
                { "key": "intake", "value": "Fall 2025" }
              ]
            }
          }
        },
        {
          "name": "Get Program by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}",
