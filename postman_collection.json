              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"email\": \"rohan@example.com\",\n  \"password\": \"Candidate123!\",\n  \"preferredCountries\": [\"Canada\", \"United Kingdom\"],\n  \"budget\": 32000,\n  \"fieldOfStudy\": [\"Computer Science\", \"Software Engineering\"],\n  \"intake\": \"Fall 2025\",\n  \"ieltsScore\": 7.5\n}"
