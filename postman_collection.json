    {
      "name": "3. University Discovery",
      "item": [
        {
          "name": "List Universities (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.length > 0) {",
                  "        pm.collectionVariables.set('universityId', json.data[0]._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities?page=1&limit=10&sort=ranking",
              "host": ["{{baseUrl}}"],
              "path": ["universities"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "ranking" }
              ]
            }
          }
        },
        {
          "name": "Filter Universities by Country & Scholarship",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities?country=Canada&scholarshipAvailable=true",
              "host": ["{{baseUrl}}"],
              "path": ["universities"],
              "query": [
                { "key": "country", "value": "Canada" },
                { "key": "scholarshipAvailable", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Get University by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/universities/{{universityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["universities", "{{universityId}}"]
            }
          }
        }
      ]
    },
